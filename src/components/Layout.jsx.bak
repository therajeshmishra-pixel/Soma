import { useState, useEffect, useRef } from 'react';
import { Link, NavLink, useLocation } from 'react-router-dom';

export default function Layout({ children }) {
  const [isMobileMenuOpen, setIsMobileMenuOpen] = useState(false);
  const [isProgramsOpen, setIsProgramsOpen] = useState(false);
  const [isCorporateOpen, setIsCorporateOpen] = useState(false);
  const [isMobileProgramsOpen, setIsMobileProgramsOpen] = useState(false);
  const [isMobileCorporateOpen, setIsMobileCorporateOpen] = useState(false);
  const programsRef = useRef(null);
  const corporateRef = useRef(null);
  const closeTimerRef = useRef(null);
  const corpCloseTimerRef = useRef(null);
  const location = useLocation();

  const PROGRAMS = [
    { id: 'sleep', icon: 'bedtime', label: 'Sleep Architecture', desc: 'Circadian recalibration & clinical sleep hygiene', pillar: '01' },
    { id: 'cognitive', icon: 'psychology', label: 'Cognitive Calm', desc: 'Decision fatigue reduction & biofeedback', pillar: '02' },
    { id: 'digital', icon: 'devices', label: 'Digital Ergonomics', desc: 'RSI correction & postural rehabilitation', pillar: '03' },
    { id: 'metabolic', icon: 'monitor_heart', label: 'Metabolic Resilience', desc: 'Precision nutrition & vitality monitoring', pillar: '04' },
    { id: 'sanctuary', icon: 'shield_person', label: 'Executive Sanctuary', desc: 'Confidential one-on-one clinical therapy', pillar: '05' },
    { id: 'counselling', icon: 'chat_bubble', label: 'Talk About What\'s Not Working', desc: 'Complimentary 30-min clinical intake session', pillar: '06', isSpecial: true },
  ];

  const CORPORATE_LINKS = [
    { id: 'workshops', icon: 'groups', label: 'Strategic Workshops', desc: 'High-stakes leadership resilience systems' },
    { id: 'wellness', icon: 'architecture', label: 'Workplace Consulting', desc: 'Environmental clinical audits & spatial design' },
    { id: 'desktop', icon: 'potted_plant', label: 'Desktop Interventions', desc: 'Micro-recovery tools for "always-on" teams' },
    { id: 'connection', icon: 'diversity_3', label: 'The Connection', desc: 'Safe-space clinical dialogue for professionals' },
  ];

  // Close mobile menu when navigating
  useEffect(() => {
    setIsMobileMenuOpen(false);
    setIsProgramsOpen(false);
    setIsCorporateOpen(false);
    setIsMobileProgramsOpen(false);
    setIsMobileCorporateOpen(false);
  }, [location.pathname]);

  useEffect(() => {
    const handleClickOutside = (e) => {
      if (programsRef.current && !programsRef.current.contains(e.target)) {
        setIsProgramsOpen(false);
      }
      if (corporateRef.current && !corporateRef.current.contains(e.target)) {
        setIsCorporateOpen(false);
      }
    };
    document.addEventListener('mousedown', handleClickOutside);
    return () => document.removeEventListener('mousedown', handleClickOutside);
  }, []);

  // Desktop Navigation Styles (Stitch Typography: Medium 14px-15px)
  const navClass = ({ isActive }) => 
    `font-inter text-[14px] lg:text-[15px] font-bold uppercase tracking-[0.12em] transition-all duration-300 ${
      isActive 
        ? 'text-emerald-700 underline underline-offset-[8px] decoration-emerald-700/50 decoration-2' 
        : 'text-slate-600 hover:text-emerald-700'
    }`;

  // Mobile Navigation Styles
  const mobileNavClass = ({ isActive }) =>
    `block py-3.5 px-6 font-inter text-[15px] font-bold uppercase tracking-wider transition-all ${
      isActive 
        ? 'text-emerald-700 bg-emerald-50/50 border-l-4 border-emerald-600' 
        : 'text-slate-600 hover:text-emerald-700 hover:bg-slate-50 border-l-4 border-transparent'
    }`;

  return (
    <>
      <header className="w-full top-0 sticky z-50 bg-white/95 backdrop-blur-md border-b border-slate-100">
        <div className="flex justify-between items-center w-full px-6 lg:px-12 py-1.5 max-w-screen-2xl mx-auto relative z-20 bg-transparent">
          {/* Logo */}
          <Link to="/" className="flex items-center">
            <img src="/Photos/SomaLogo.svg" alt="SOMA" className="h-20 md:h-28 w-auto object-contain transition-all duration-300" />
          </Link>
          
          {/* Desktop/Tablet Nav */}
          <nav className="hidden xl:flex items-center gap-6 lg:gap-10">
            <NavLink to="/" className={navClass}>Home</NavLink>

            {/* Programs Dropdown */}
            <div
              className="relative"
              ref={programsRef}
              onMouseEnter={() => {
                clearTimeout(closeTimerRef.current);
                setIsProgramsOpen(true);
              }}
              onMouseLeave={() => {
                closeTimerRef.current = setTimeout(() => setIsProgramsOpen(false), 150);
              }}
            >
              <button
                onClick={() => setIsProgramsOpen(!isProgramsOpen)}
                className={`flex items-center gap-0.5 font-inter text-[14px] lg:text-[15px] font-bold uppercase tracking-[0.12em] transition-all duration-300 ${
                  location.pathname.startsWith('/programs') ? 'text-emerald-700' : 'text-slate-600 hover:text-emerald-700'
                }`}
              >
                <span className={location.pathname.startsWith('/programs') ? 'underline underline-offset-[8px] decoration-emerald-700/50 decoration-2' : ''}>
                  Programs
                </span>
                <span
                  className={`material-symbols-outlined text-[16px] transition-transform duration-200 leading-none ${isProgramsOpen ? 'rotate-180' : ''}`}
                >
                  expand_more
                </span>
              </button>

              {/* Dropdown Panel */}
              <div
                className={`absolute top-[calc(100%+12px)] left-1/2 -translate-x-1/2 w-[520px] bg-white rounded-2xl shadow-[0_20px_60px_-10px_rgba(0,0,0,0.15)] border border-slate-100/80 overflow-hidden transition-all duration-200 origin-top z-[999] ${
                  isProgramsOpen ? 'opacity-100 scale-100 translate-y-0 pointer-events-auto' : 'opacity-0 scale-95 -translate-y-2 pointer-events-none'
                }`}
              >
                {/* Header */}
                <div className="px-5 pt-5 pb-3 border-b border-slate-100">
                  <p className="text-[10px] font-inter font-bold text-emerald-700 uppercase tracking-[0.15em]">Clinical Programs</p>
                  <p className="text-xs text-slate-400 font-inter mt-0.5">Select a pillar to explore</p>
                </div>

                {/* Program List */}
                <div className="p-3">
                  {PROGRAMS.map((prog) => (
                    <div key={prog.id}>
                      {prog.isSpecial && (
                        <div className="mx-3 my-2 pt-2 border-t border-slate-100">
                          <p className="text-[9px] font-inter font-bold text-emerald-600 uppercase tracking-[0.15em] px-1 mb-1">Counselling</p>
                        </div>
                      )}
                      <Link
                        to={`/programs/${prog.id}`}
                        onClick={() => setIsProgramsOpen(false)}
                        className={`flex items-center gap-3 px-3 py-3 rounded-xl hover:bg-emerald-50/60 transition-all duration-150 group ${
                          prog.isSpecial ? 'bg-emerald-50/30' : ''
                        }`}
                      >
                        {/* Icon */}
                        <div className="w-9 h-9 rounded-xl bg-slate-100 group-hover:bg-emerald-100 flex items-center justify-center transition-colors flex-shrink-0">
                          <span className="material-symbols-outlined text-[18px] text-slate-500 group-hover:text-emerald-700 transition-colors">{prog.icon}</span>
                        </div>
                        {/* Text */}
                        <div className="flex-1 min-w-0">
                          <div className="text-[13px] font-inter font-semibold text-slate-800 group-hover:text-emerald-800 transition-colors">{prog.label}</div>
                          <div className="text-[11px] font-inter text-slate-400 mt-0.5 truncate">{prog.desc}</div>
                        </div>
                        {/* Pillar badge */}
                        <div className="text-[10px] font-inter font-bold text-slate-300 group-hover:text-emerald-500 transition-colors tracking-widest flex-shrink-0">P{prog.pillar}</div>
                      </Link>
                    </div>
                  ))}
                </div>

                {/* Footer CTA */}
                <div className="px-5 py-4 border-t border-slate-100 flex items-center justify-between bg-slate-50/50">
                  <span className="text-[11px] font-inter text-slate-400">6 clinical programs available</span>
                  <Link
                    to="/programs"
                    onClick={() => setIsProgramsOpen(false)}
                    className="text-[12px] font-inter font-semibold text-emerald-700 hover:text-emerald-900 flex items-center gap-1 transition-colors"
                  >
                    View All Programs
                    <span className="material-symbols-outlined text-[14px]">arrow_forward</span>
                  </Link>
                </div>
              </div>
            </div>

            <NavLink to="/about" className={navClass}>About</NavLink>

            {/* Corporate Dropdown */}
            <div
              className="relative"
              ref={corporateRef}
              onMouseEnter={() => {
                clearTimeout(corpCloseTimerRef.current);
                setIsCorporateOpen(true);
              }}
              onMouseLeave={() => {
                corpCloseTimerRef.current = setTimeout(() => setIsCorporateOpen(false), 150);
              }}
            >
              <button
                onClick={() => setIsCorporateOpen(!isCorporateOpen)}
                className={`flex items-center gap-0.5 font-inter text-[14px] lg:text-[15px] font-bold uppercase tracking-[0.12em] transition-all duration-300 ${
                  location.pathname.startsWith('/corporate') ? 'text-emerald-700' : 'text-slate-600 hover:text-emerald-700'
                }`}
              >
                <span className={location.pathname.startsWith('/corporate') ? 'underline underline-offset-[8px] decoration-emerald-700/50 decoration-2' : ''}>
                  Corporate
                </span>
                <span
                  className={`material-symbols-outlined text-[16px] transition-transform duration-200 leading-none ${isCorporateOpen ? 'rotate-180' : ''}`}
                >
                  expand_more
                </span>
              </button>

              {/* Dropdown Panel */}
              <div
                className={`absolute top-[calc(100%+12px)] left-1/2 -translate-x-1/2 w-[480px] bg-white rounded-2xl shadow-[0_20px_60px_-10px_rgba(0,0,0,0.15)] border border-slate-100/80 overflow-hidden transition-all duration-200 origin-top z-[999] ${
                  isCorporateOpen ? 'opacity-100 scale-100 translate-y-0 pointer-events-auto' : 'opacity-0 scale-95 -translate-y-2 pointer-events-none'
                }`}
              >
                {/* Header */}
                <div className="px-5 pt-5 pb-3 border-b border-slate-100">
                  <p className="text-[10px] font-inter font-bold text-soma-gold uppercase tracking-[0.15em]">Institutional Services</p>
                  <p className="text-xs text-slate-400 font-inter mt-0.5">High-authority corporate recovery</p>
                </div>

                {/* Links List */}
                <div className="p-3">
                  {CORPORATE_LINKS.map((link) => (
                    <Link
                      key={link.id}
                      to={`/corporate/${link.id}`}
                      onClick={() => setIsCorporateOpen(false)}
                      className="flex items-center gap-3 px-3 py-3 rounded-xl hover:bg-slate-50 transition-all duration-150 group"
                    >
                      <div className="w-9 h-9 rounded-xl bg-slate-50 group-hover:bg-soma-gold/10 flex items-center justify-center transition-colors flex-shrink-0">
                        <span className="material-symbols-outlined text-[18px] text-slate-400 group-hover:text-soma-gold transition-colors">{link.icon}</span>
                      </div>
                      <div className="flex-1 min-w-0">
                        <div className="text-[13px] font-inter font-semibold text-slate-800 group-hover:text-emerald-800 transition-colors">{link.label}</div>
                        <div className="text-[11px] font-inter text-slate-400 mt-0.5 truncate">{link.desc}</div>
                      </div>
                    </Link>
                  ))}
                </div>

                {/* Footer CTA */}
                <div className="px-5 py-4 border-t border-slate-100 flex items-center justify-between bg-slate-50/50">
                  <span className="text-[11px] font-inter text-slate-400">Institutional Interventions</span>
                  <Link
                    to="/corporate"
                    onClick={() => setIsCorporateOpen(false)}
                    className="text-[12px] font-inter font-semibold text-soma-gold hover:text-emerald-900 flex items-center gap-1 transition-colors"
                  >
                    Corporate Hub
                    <span className="material-symbols-outlined text-[14px]">arrow_forward</span>
                  </Link>
                </div>
              </div>
            </div>

            <NavLink to="/portal" className={navClass}>Portal</NavLink>
            <NavLink to="/assessment" className={navClass}>Assessment</NavLink>
          </nav>

          {/* Desktop CTA */}
          <div className="hidden xl:block">
            <Link to="/contact" className="font-inter text-[14px] font-semibold signature-gradient text-white px-6 py-2.5 rounded-md hover:opacity-90 transition-all duration-300 active:scale-95 shadow-sm whitespace-nowrap">
              Contact Us
            </Link>
          </div>

          {/* Mobile Menu Button */}
          <button 
            className="xl:hidden flex items-center p-2 -mr-2 text-slate-600 hover:text-slate-900 transition-colors"
            onClick={() => setIsMobileMenuOpen(!isMobileMenuOpen)}
            aria-label="Toggle Menu"
          >
            <span className="material-symbols-outlined text-3xl">
              {isMobileMenuOpen ? 'close' : 'menu'}
            </span>
          </button>
        </div>

        {/* Mobile Navigation Dropdown */}
        <div 
          className={`xl:hidden absolute top-full left-0 w-full bg-white shadow-xl transition-all duration-300 ease-in-out border-b border-slate-100 ${
            isMobileMenuOpen 
              ? 'opacity-100 translate-y-0 visible shadow-2xl' 
              : 'opacity-0 -translate-y-4 invisible pointer-events-none shadow-none'
          }`}
        >
          <nav className="flex flex-col py-4 max-h-[85vh] overflow-y-auto">
            <NavLink to="/" className={mobileNavClass}>Home</NavLink>

            {/* Mobile Programs Accordion */}
            <div>
              <button
                className={`w-full flex items-center justify-between py-3.5 px-6 font-inter text-[15px] font-bold uppercase tracking-wider transition-all border-l-4 ${
                  location.pathname === '/programs'
                    ? 'text-emerald-800 bg-emerald-50/50 border-emerald-600'
                    : 'text-slate-600 hover:text-emerald-800 hover:bg-slate-50 border-transparent'
                }`}
                onClick={() => setIsMobileProgramsOpen(!isMobileProgramsOpen)}
              >
                Programs
                <span className={`material-symbols-outlined text-[20px] transition-transform duration-200 ${isMobileProgramsOpen ? 'rotate-180' : ''}`}>
                  expand_more
                </span>
              </button>

              {/* Sub-menu */}
              <div className={`overflow-hidden transition-all duration-300 ${
                isMobileProgramsOpen ? 'max-h-96 opacity-100' : 'max-h-0 opacity-0'
              }`}>
                <div className="bg-slate-50/70 border-l-4 border-emerald-100">
                  {PROGRAMS.map((prog) => (
                    <Link
                      key={prog.id}
                      to={`/programs/${prog.id}`}
                      className="flex items-center gap-3 px-6 py-3 hover:bg-emerald-50 transition-colors"
                    >
                      <span className="material-symbols-outlined text-[16px] text-slate-400">{prog.icon}</span>
                      <div>
                        <div className="text-[14px] font-inter font-semibold text-slate-700">{prog.label}</div>
                        <div className="text-[11px] font-inter text-slate-400">{prog.desc}</div>
                      </div>
                    </Link>
                  ))}
                  <Link
                    to="/programs"
                    className="flex items-center gap-2 px-6 py-3.5 text-[13px] font-inter font-semibold text-emerald-700 hover:bg-emerald-50 transition-colors border-t border-slate-100"
                  >
                    View All Programs
                    <span className="material-symbols-outlined text-[14px]">arrow_forward</span>
                  </Link>
                </div>
              </div>
            </div>

            <NavLink to="/about" className={mobileNavClass}>About</NavLink>

            {/* Mobile Corporate Accordion */}
            <div>
              <button
                className={`w-full flex items-center justify-between py-3.5 px-6 font-inter text-[15px] font-bold uppercase tracking-wider transition-all border-l-4 ${
                  location.pathname === '/corporate'
                    ? 'text-emerald-800 bg-emerald-50/50 border-emerald-600'
                    : 'text-slate-600 hover:text-emerald-800 hover:bg-slate-50 border-transparent'
                }`}
                onClick={() => setIsMobileCorporateOpen(!isMobileCorporateOpen)}
              >
                Corporate
                <span className={`material-symbols-outlined text-[20px] transition-transform duration-200 ${isMobileCorporateOpen ? 'rotate-180' : ''}`}>
                  expand_more
                </span>
              </button>

              <div className={`overflow-hidden transition-all duration-300 ${
                isMobileCorporateOpen ? 'max-h-96 opacity-100' : 'max-h-0 opacity-0'
              }`}>
                <div className="bg-slate-50/70 border-l-4 border-emerald-100">
                  {CORPORATE_LINKS.map((link) => (
                    <Link
                      key={link.id}
                      to={`/corporate/${link.id}`}
                      className="flex items-center gap-3 px-6 py-3 hover:bg-emerald-50 transition-colors"
                    >
                      <span className="material-symbols-outlined text-[16px] text-slate-400">{link.icon}</span>
                      <div>
                        <div className="text-[14px] font-inter font-semibold text-slate-700">{link.label}</div>
                        <div className="text-[11px] font-inter text-slate-400">{link.desc}</div>
                      </div>
                    </Link>
                  ))}
                  <Link
                    to="/corporate"
                    className="flex items-center gap-2 px-6 py-3.5 text-[13px] font-inter font-semibold text-soma-gold hover:bg-emerald-50 transition-colors border-t border-slate-100"
                  >
                    Corporate Hub
                    <span className="material-symbols-outlined text-[14px]">arrow_forward</span>
                  </Link>
                </div>
              </div>
            </div>

            <NavLink to="/portal" className={mobileNavClass}>Portal</NavLink>
            <NavLink to="/assessment" className={mobileNavClass}>Assessment</NavLink>
            
            <div className="px-6 pt-6 pb-4 mt-2">
               <Link to="/contact" className="block w-full text-center font-inter text-[16px] font-bold signature-gradient text-white px-6 py-3.5 rounded-md hover:opacity-90 transition-all duration-300 active:scale-95 shadow-lg">
                 Contact Us
               </Link>
            </div>
          </nav>
        </div>
      </header>

      {children}

      <footer className="w-full py-12 px-8 bg-stone-50 border-t border-stone-200 mt-auto">
        <div className="flex flex-col md:flex-row justify-between items-center md:items-start gap-8 max-w-7xl mx-auto">
          {/* Brand & Copyright */}
          <div className="flex flex-col items-center md:items-start gap-4">
            <img src="/Photos/SomaLogo.svg" alt="SOMA" className="h-16 w-auto object-contain" />
            <p className="text-xs text-slate-500 font-body">© 2024 SOMA Professional Ecosystem. All rights reserved.</p>
          </div>
          
          {/* Social Presence */}
          <div className="flex flex-col items-center md:items-start gap-3">
             <span className="text-xs font-semibold text-slate-400 uppercase tracking-widest font-label">Connect</span>
             <div className="flex gap-5">
               <a href="#" aria-label="LinkedIn" className="text-slate-400 hover:text-emerald-700 hover:-translate-y-0.5 transition-all duration-300">
                 <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
               </a>
               <a href="#" aria-label="Instagram" className="text-slate-400 hover:text-emerald-700 hover:-translate-y-0.5 transition-all duration-300">
                 <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
               </a>
               <a href="#" aria-label="Twitter" className="text-slate-400 hover:text-emerald-700 hover:-translate-y-0.5 transition-all duration-300">
                 <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"></path></svg>
               </a>
               <a href="#" aria-label="Facebook" className="text-slate-400 hover:text-emerald-700 hover:-translate-y-0.5 transition-all duration-300">
                 <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
               </a>
             </div>
          </div>

          {/* Legal Links */}
          <div className="flex flex-col items-center md:items-end gap-3">
            <span className="text-xs font-semibold text-slate-400 uppercase tracking-widest font-label">Legal</span>
            <div className="flex gap-6">
              <Link to="#" className="text-slate-500 hover:text-emerald-700 transition-all text-sm font-body">Privacy</Link>
              <Link to="#" className="text-slate-500 hover:text-emerald-700 transition-all text-sm font-body">Standards</Link>
              <Link to="#" className="text-slate-500 hover:text-emerald-700 transition-all text-sm font-body">Terms</Link>
            </div>
          </div>
        </div>
      </footer>
    </>
  );
}
